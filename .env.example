# === 数据库 ===
# 本地开发可用 Docker 起一个 PostgreSQL；部署到 Railway 时，
# 加一个 PostgreSQL Plugin 后，Railway 会自动帮你注入 DATABASE_URL，不用手动填。
DATABASE_URL="postgresql://user:password@localhost:5432/benmachi?schema=public"

# === 服务器 ===
PORT=3000
# 部署后的完整网址（不要有结尾斜线），LINE 登入回调会用到，例如：
# https://benmachi-points-production.up.railway.app
APP_BASE_URL="http://localhost:3000"

# === JWT 签章密钥（登入用），请自行换成一长串随机字符 ===
# 可用指令产生： node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# === 门店时区（影响「今日签到」「今日营收」等统计的日期切换点）===
STORE_TZ="Asia/Taipei"

# === LINE Login ===
# 到 https://developers.line.biz/console/ 建立一个 Channel 类型选「LINE Login」，
# 在 Channel 设定的 Basic settings 可以找到 Channel ID / Channel secret，
# 并在 LINE Login 分页的 Callback URL 填入： {APP_BASE_URL}/api/auth/line/callback
LINE_CHANNEL_ID="your-line-login-channel-id"
LINE_CHANNEL_SECRET="your-line-login-channel-secret"

# === 初始管理员帐号（只有第一次执行 npm run seed 时会用到）===
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="benmachi2026"
SEED_ADMIN_NAME="店长"

# 是否为正式环境（影响 cookie 的 secure 旗标；Railway 上请设为 production）
NODE_ENV="development"
